{
  "name": "npa-ecm",
  "version": "1.0.0",
  "description": "NPA Electronic Content Management System",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspace=frontend",
    "test": "npm run test --workspace=frontend",
    "clean": "rm -rf node_modules frontend/node_modules && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npa/npa-ecm.git"
  },
  "keywords": [
    "ecm",
    "dms",
    "document-management",
    "npa",
    "react",
    "nextjs",
    "django"
  ],
  "author": "NPA Development Team",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/npa/npa-ecm/issues"
  },
  "homepage": "https://github.com/npa/npa-ecm#readme",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}