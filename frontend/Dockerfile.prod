FROM node:20-alpine AS builder
WORKDIR /app

# Accept build arguments for Next.js public environment variables
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_ENVIRONMENT

# Expose them during build (NEXT_PUBLIC_* is baked into the client bundle)
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_ENVIRONMENT=$NEXT_PUBLIC_ENVIRONMENT

# Install workspace dependencies (root package.json defines the "frontend" workspace)
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
RUN npm ci

# Copy frontend source and build
COPY frontend/ ./frontend
RUN npm run build --workspace=frontend

# Minimal runtime image using Next.js standalone output
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Copy standalone server and required files (no runtime npm install)
# npm workspace creates a "frontend" subdirectory in the standalone output
COPY --from=builder --chown=node:node /app/frontend/.next/standalone/ ./
COPY --from=builder --chown=node:node /app/frontend/.next/static ./frontend/.next/static
COPY --from=builder --chown=node:node /app/frontend/public ./frontend/public

WORKDIR /app/frontend

USER node
EXPOSE 3000
CMD ["node", "server.js"]
