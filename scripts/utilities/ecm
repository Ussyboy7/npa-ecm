#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PRODUCTION_SCRIPT_DIR="${SCRIPT_DIR}/../production"
OPS_SCRIPT_DIR="${SCRIPT_DIR}/../ops"

usage() {
  cat <<'USAGE'
Usage:
  scripts/utilities/ecm <command> <env> [options] [-- docker args]

Commands:
  up|start <env>        Start the stack
  down|stop <env>       Stop the stack
  restart <env>         Restart the stack
  status <env>          Show container status
  logs <env> [svc]      Show logs
  health <env>          Check backend + frontend health
  migrate <env>         Run Django migrations
  seed <env>            Run seed_demo_data

Environments: local | stag | prod

Examples:
  scripts/utilities/ecm up local
  scripts/utilities/ecm health stag
  scripts/utilities/ecm logs local backend --follow
USAGE
}

if [[ $# -lt 2 ]]; then
  usage
  exit 1
fi

COMMAND="$1"
ENVIRONMENT="$2"
shift 2 || true

map_env() {
  case "$1" in
    local) echo "local" ;;
    stag|staging) echo "stag" ;;
    prod|production) echo "prod" ;;
    *) echo "$1" ;;
  esac
}

ENV="$(map_env "$ENVIRONMENT")"

case "$COMMAND" in
  up|start)
    exec "${OPS_SCRIPT_DIR}/env-manager.sh" "$ENV" start "$@"
    ;;
  down|stop)
    exec "${OPS_SCRIPT_DIR}/env-manager.sh" "$ENV" stop "$@"
    ;;
  restart)
    exec "${OPS_SCRIPT_DIR}/env-manager.sh" "$ENV" restart "$@"
    ;;
  status)
    exec "${OPS_SCRIPT_DIR}/env-manager.sh" "$ENV" status "$@"
    ;;
  logs)
    exec "${OPS_SCRIPT_DIR}/env-manager.sh" "$ENV" logs "$@"
    ;;
  health)
    exec "${OPS_SCRIPT_DIR}/env-manager.sh" "$ENV" health "$@"
    ;;
  migrate)
    exec "${OPS_SCRIPT_DIR}/env-manager.sh" "$ENV" migrate "$@"
    ;;
  seed)
    exec "${OPS_SCRIPT_DIR}/env-manager.sh" "$ENV" seed "$@"
    ;;
  deploy)
    exec "${OPS_SCRIPT_DIR}/env-manager.sh" "$ENV" deploy "$@"
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    usage
    exit 1
    ;;
esac
