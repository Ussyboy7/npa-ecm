# Copy to backend/env/stag.env on the staging server (not committed).

DJANGO_ENV=stag
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-strong-secret

DB_ENGINE=postgres
DB_NAME=npa_ecm_stag
DB_USER=ecmadmin
DB_PASSWORD=replace-me
# Web/API talk to PgBouncer (compose overrides DB_HOST for celery → postgres).
DB_HOST=pgbouncer
DB_PORT=5432
DB_CONN_MAX_AGE=60

REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

ALLOWED_HOSTS=172.16.0.46,localhost,backend
CORS_ALLOWED_ORIGINS=http://172.16.0.46:4646
CSRF_TRUSTED_ORIGINS=http://172.16.0.46:4646

LOG_LEVEL=INFO

# Deploy scale (used by scripts/ops/env-manager.sh deploy)
# BACKEND_REPLICAS=2
# CELERY_REPLICAS=2
# FRONTEND_REPLICAS=2
# CELERY_CONCURRENCY=2
