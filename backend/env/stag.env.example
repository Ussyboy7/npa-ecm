# Copy to backend/env/stag.env on the staging server (not committed).

DJANGO_ENV=stag
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-strong-secret

DB_ENGINE=postgres
DB_NAME=npa_ecm_stag
DB_USER=ecmadmin
DB_PASSWORD=replace-me
DB_HOST=postgres_stag
DB_PORT=5432

REDIS_HOST=redis_stag
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis_stag:6379/0
CELERY_RESULT_BACKEND=redis://redis_stag:6379/1

ALLOWED_HOSTS=172.16.0.46,localhost,backend_stag
CORS_ALLOWED_ORIGINS=http://172.16.0.46:4646
CSRF_TRUSTED_ORIGINS=http://172.16.0.46:4646

LOG_LEVEL=INFO
