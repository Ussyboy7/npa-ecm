# Copy to backend/env/local.env (not committed).
# Docker: DB_HOST=postgres, REDIS_HOST=redis
# Native dev on Mac: DB_HOST=localhost, DB_PORT=5433, REDIS_PORT=6380

DJANGO_ENV=local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=changeme-local-dev-only

DB_ENGINE=postgres
DB_NAME=npa_ecm_local
DB_USER=ecmadmin
DB_PASSWORD=ecmadmin
DB_HOST=postgres
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
CSRF_TRUSTED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

THROTTLE_USER_RATE=1000/minute
LOG_LEVEL=INFO
