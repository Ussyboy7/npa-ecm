# Copy to backend/env/prod.env on the production server (not committed).

DJANGO_ENV=prod
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-strong-secret

DB_ENGINE=postgres
DB_NAME=npa_ecm_prod
DB_USER=npa_ecm_prod
DB_PASSWORD=replace-me
DB_HOST=postgres
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

ALLOWED_HOSTS=ecm.nigerianports.gov.ng
CORS_ALLOWED_ORIGINS=https://ecm.nigerianports.gov.ng
CSRF_TRUSTED_ORIGINS=https://ecm.nigerianports.gov.ng

LOG_LEVEL=WARNING
